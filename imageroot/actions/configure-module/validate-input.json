{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://nethserver.org/json-schema/task/input/organizr/configure-module",
  "title": "Configure Organizr",
  "description": "Configure the Organizr virtual host",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "http2https", "lets_encrypt", "setup_mode"],
  "properties": {
    "host": {
      "type": "string",
      "description": "Fully qualified hostname for Organizr",
      "format": "hostname",
      "pattern": "\\."
    },
    "http2https": {
      "type": "boolean",
      "title": "HTTP to HTTPS redirection",
      "description": "Redirect HTTP requests to HTTPS"
    },
    "lets_encrypt": {
      "type": "boolean",
      "title": "Let's Encrypt certificate",
      "description": "Request a Let's Encrypt certificate"
    },
    "setup_mode": {
      "type": "string",
      "title": "Initial setup mode",
      "description": "Choose the Organizr wizard or unattended NS8 setup; the choice is fixed once initialization begins.",
      "enum": ["manual", "managed"]
    },
    "ad_enabled": {
      "type": "boolean",
      "title": "Active Directory login",
      "default": false
    },
    "ad_domain": {
      "type": "string",
      "title": "NS8 Active Directory account domain",
      "maxLength": 253,
      "default": ""
    },
    "ad_user_search_base": {
      "type": "string",
      "title": "Optional AD search base DN; defaults to the domain base DN",
      "maxLength": 2048,
      "default": ""
    }
  },
  "examples": [
    {
      "host": "organizr.example.org",
      "http2https": true,
      "lets_encrypt": false,
      "setup_mode": "managed",
      "ad_enabled": true,
      "ad_domain": "ad.example.org"
    }
  ]
}
