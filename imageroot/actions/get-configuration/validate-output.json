{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://nethserver.org/json-schema/task/output/organizr/get-configuration",
  "title": "Get Organizr settings",
  "description": "Return the Organizr virtual host configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "http2https", "lets_encrypt", "setup_mode"],
  "properties": {
    "host": {
      "type": "string",
      "description": "Fully qualified hostname for Organizr"
    },
    "http2https": {
      "type": "boolean",
      "title": "HTTP to HTTPS redirection"
    },
    "lets_encrypt": {
      "type": "boolean",
      "title": "Let's Encrypt certificate"
    },
    "setup_mode": {
      "type": "string",
      "enum": ["pending", "manual", "managed"]
    }
  }
}
