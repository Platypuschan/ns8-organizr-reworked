# SPDX-License-Identifier: GPL-3.0-or-later

import json
import os
import sys

import agent

setup = agent.read_envfile("organizr-setup.env")
setup_mode = setup.get("ORGANIZR_SETUP_MODE", "")
agent.assert_exp(setup_mode in {"pending", "manual", "managed"}, "Invalid setup mode in module state.")
ad = agent.read_envfile("organizr-ad.env")

json.dump(
    {
        "host": os.getenv("TRAEFIK_HOST", ""),
        # Before the first configuration, suggest the HTTPS redirect.
        "http2https": os.getenv("TRAEFIK_HTTP2HTTPS", "true").lower() == "true",
        "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT", "").lower() == "true",
        "setup_mode": setup_mode,
        "ad_enabled": ad.get("ORGANIZR_AD_ENABLED") == "true",
        "ad_domain": ad.get("ORGANIZR_AD_DOMAIN", ""),
        "ad_user_search_base": ad.get("ORGANIZR_AD_USER_SEARCH_BASE", ""),
    },
    fp=sys.stdout,
)
