{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>NethServer/.github:ns8"],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the official Organizr container image",
      "fileMatch": ["(^|/)build-images\\.sh$"],
      "matchStrings": [
        "organizr_image=\"(?<depName>ghcr\\.io/organizr/organizr):(?<currentValue>[-0-9A-Za-z_.]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
